<% if(allListings.length === 0) { %>

  <div class="empty-wrapper container">
    <div class="alert alert-danger empty-state text-center">
      <h5>No listings found </h5>
      <p>Try another category or filter</p>
    </div>
  </div>

<% } else { %>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card col listing-card">
          <img src="<%= listing.image.url %>" class="card-img-top">
          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b><br>
             ₹<span class="base-price"><%= listing.price %></span>/night
            <!-- <span class="tax-info"> +18% GST</span> -->
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>

<% } %>
