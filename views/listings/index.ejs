    <script>
let taxSwitch = document.getElementById("switchCheckDefault");

taxSwitch.addEventListener('change', () => {
  let prices = document.querySelectorAll(".base-price");

  prices.forEach(priceEl => {
    let basePrice = Number(priceEl.dataset.original || priceEl.innerText);

    // store original once
    priceEl.dataset.original = basePrice;

    if (taxSwitch.checked) {
      let finalPrice = Math.round(basePrice * 1.18);
      priceEl.innerText = finalPrice.toLocaleString("en-IN");
    } else {
      priceEl.innerText = basePrice.toLocaleString("en-IN");
    }
  });

  // toggle GST text
  let taxinfo = document.getElementsByClassName("tax-info");
  for (let info of taxinfo) {
    info.style.display = taxSwitch.checked ? "inline" : "none";
  }
});
</script>