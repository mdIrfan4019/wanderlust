<% layout('layouts/boilerplate') %>
  <style>
    #filters {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
    }

    .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.7;

      /* 🔥 ADD THESE LINES */
      text-decoration: none;
      color: inherit;
    }

    .filter:hover {
      opacity: 1;
      cursor: pointer;
      transform: scale(1.05);
      /* 🔥 subtle zoom */

    }

    .filter p {
      font-size: 0.8rem;
    }

    .tax-info {
      display: none;
    }

    .tax-toggle {
      border: 1px solid black;
      border-radius: 1rem;
      height: 3.2rem;
      padding: 1rem;
      margin-left: 2rem;
      display: flex;
      align-items: center;
    }

    .empty-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
}

.empty-state {
  max-width: 500px;
  width: 100%;
  padding: 1.5rem;
  border-radius: 12px;
  text-align: center;
}

    /* ---------- MEDIA QUERIES ---------- */

    /* Tablets (≤ 992px) */
    @media (max-width: 992px) {
      .filter {
        margin-right: 1.2rem;
      }

      .filter p {
        font-size: 0.75rem;
      }

      .tax-toggle {
        margin-left: auto;
        /* push it to right edge */
      }
    }

    /* Mobiles (≤ 768px) */
    @media (max-width: 768px) {
      #filters {
        justify-content: center;
      }

      .filter {
        margin-right: 1rem;
        margin-top: 1rem;
        flex: 1 1 30%;
        /* 3 per row */
      }

      .tax-toggle {
        width: 100%;
        justify-content: center;
        margin: 1rem auto 0 auto;
      }
    }

    /* Small mobiles (≤ 480px) */
    @media (max-width: 480px) {
      .filter {
        flex: 1 1 45%;
        /* 2 per row */
      }

      .filter p {
        font-size: 0.7rem;
      }

      .tax-toggle {
        font-size: 0.75rem;
        height: auto;
        padding: 0.6rem;
      }
    }
  </style>


  <!-- 🔥 ADD HERE (FILTER FORM) -->
  <div class="filters-container mb-4">
    <form action="/listings" method="GET" class="row g-3">

      <div class="col-md-4">
        <input type="text" name="location" class="form-control" placeholder="Search by location"
          value="<%= request?.query?.location || '' %>">
      </div>

      <div class="col-md-4">
        <input type="number" name="price" class="form-control" placeholder="Max price"
          value="<%= request?.query?.price || '' %>">
      </div>

      <div class="col-md-2">
        <button class="btn apply-btn w-100">Apply</button>
      </div>

      <div class="col-md-2">
        <a href="/listings" class="btn reset-btn w-100">Reset</a>
      </div>

    </form>
  </div>


  <!-- 👇 YOUR EXISTING CODE -->
  
